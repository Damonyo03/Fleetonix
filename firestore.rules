rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // accidents: Drivers can write reports; admins can read/update (acknowledge)
    match /accidents/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // vehicle_issues: Drivers can write issue reports
    match /vehicle_issues/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ────────────────────────────────────────────────────────────────────────
    // DRIVER LOCATIONS (Real-time telemetry)
    // ────────────────────────────────────────────────────────────────────────
    /**
     * Security Rules for Telemetry:
     * - READ: Accessible by authenticated users (admins) to monitor the fleet.
     * - WRITE: Only the owner (driver) of the document can push location updates.
     * - UPDATE: Fields like 'is_background' and 'last_updated' are required for dashboard sync.
     */
    match /driver_locations/{driverEmail} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email.lower() == driverEmail.lower();
    }

    // dtr_logs: Drivers can write their own clock-in/out records
    match /dtr_logs/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // attendance: Drivers can read/write their own records (legacy alias)
    match /attendance/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // drivers: Drivers can read and update their own profile/status
    match /drivers/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // trip_tickets: Drivers can read their own tickets; admins can read all
    match /trip_tickets/{ticketId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // schedules: Drivers can read and update trip phases
    match /schedules/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Public Read for Accredited Companies (Required for registration dropdown)
    match /accredited_companies/{companyId} {
      allow read: if true;
      allow write: if request.auth != null && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin');
    }

    // notifications: Real-time alerts
    match /notifications/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // users: Authenticated read, self-write or admin write
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Default catch-all: Read for authenticated users, write for admins only
    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin' || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'company_admin'
      );
    }
  }
}
