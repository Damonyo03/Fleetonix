rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Reusable Admin Gate ───────────────────────────────────────────
    function isAdmin() {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return u.role in ['super_admin', 'company_admin', 'admin'] || 
             u.user_type in ['super_admin', 'company_admin', 'admin'];
    }

    // ── driver_locations: owner-only write, auth-only read ──────────────
    match /driver_locations/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && (request.auth.uid == docId || request.auth.token.email.lower() == docId.lower())
        // Coordinate plausibility guard
        && request.resource.data.current_latitude is number
        && request.resource.data.current_latitude >= -90
        && request.resource.data.current_latitude <= 90
        && request.resource.data.current_longitude is number
        && request.resource.data.current_longitude >= -180
        && request.resource.data.current_longitude <= 180;
    }

    // ── drivers: admins full CRUD; self-ownership read/write ────────────
    match /drivers/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // ── bookings: admins full CRUD ─────────────────────────────────────
    match /bookings/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    // ── schedules: drivers update trip_phase only; admins full write ────
    match /schedules/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
      allow update: if request.auth != null
        && request.auth.token.email.lower() == resource.data.driver_email.lower()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'status', 'trip_phase', 'accepted_at', 'started_at', 'picked_up_at', 
             'dropped_off_at', 'completed_at', 'driver_viewed_at', 'total_km_travelled', 
             'current_segment_index', 'total_segments_completed', 'segments', 
             'odometer_start', 'odometer_end', 'passenger_signature_url', 
             'driver_signature_url', 'refusal_reason', 'vehicle_type', 'plate_number', 
             'route_polyline', 'actual_route_polyline', 'time_of_departure', 'time_of_arrival', 'last_updated',
             'cancellation_reason', 'cancelled_at'
           ]);
    }

    // ── drivers: drivers update own status; admins full access ───────────
    match /drivers/{docId} {
      allow read: if request.auth != null;
      allow update: if request.auth != null
        && (resource.data.driver_email.lower() == request.auth.token.email.lower()
            || docId == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'current_status', 'current_trip_id', 'current_trip_phase', 
             'current_mileage', 'active_ticket_id', 'last_updated', 'on_break'
           ]);
      allow write: if request.auth != null && isAdmin();
    }

    // ── trip_tickets: drivers create/update own; admins full access ──────
    match /trip_tickets/{docId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && (request.resource.data.driver_email.lower() == request.auth.token.email.lower()
            || request.resource.data.driver_uid == request.auth.uid);
      allow delete: if request.auth != null && isAdmin();
    }

    // ── incidents: drivers can create; admins full access ───────────────
    match /incidents/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.driver_email.lower() == request.auth.token.email.lower();
      allow update, delete: if request.auth != null && isAdmin();
    }

    // ── accidents: drivers can create; admins full access ───────────────
    match /accidents/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.driver_email.lower() == request.auth.token.email.lower();
      allow update, delete: if request.auth != null && isAdmin();
    }

    // ── vehicle_issues: drivers can create; admins full access ──────────
    match /vehicle_issues/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.driver_email.lower() == request.auth.token.email.lower();
      allow update, delete: if request.auth != null && isAdmin();
    }

    // ── dtr_logs: drivers write own records; admins full access ──────────
    match /dtr_logs/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.driver_email.lower()
             == request.auth.token.email.lower();
      allow update, delete: if request.auth != null && isAdmin();
    }

    // ── Everything else: admin-only write ───────────────────────────────
    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }
  }
}
