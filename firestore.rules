rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Secure driver_locations: Read for all users, write only for owner
    match /driver_locations/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Default catch-all for other collections (temporary permissive)
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2026, 4, 8);
    }
  }
}
