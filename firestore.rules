rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Reusable Logic ───────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) && (
        get(path).data.get('role', 'none') in ['super_admin', 'company_admin', 'admin'] || 
        get(path).data.get('user_type', 'none') in ['super_admin', 'company_admin', 'admin']
      );
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Safer email access that won't crash the rule if token email is null
    function getAuthEmail() {
      return request.auth.token.get('email', '').lower();
    }

    // ── driver_locations: owner-only write, admins-only read ──────────────
    match /driver_locations/{docId} {
      allow read: if isSignedIn() && (isOwner(docId) || resource.data.get('driver_uid', '') == request.auth.uid || isAdmin());
      allow write: if isSignedIn() && (isOwner(docId) || request.resource.data.get('driver_uid', '') == request.auth.uid)
        && request.resource.data.current_latitude is number
        && request.resource.data.current_longitude is number;
    }

    // ── drivers: self-update status/telemetry, admins full CRUD ────────────
    match /drivers/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || resource.data.get('driver_uid', '') == request.auth.uid || isAdmin());
      allow update: if isSignedIn() 
        && (isOwner(userId) || 
            resource.data.get('driver_uid', '') == request.auth.uid || 
            getAuthEmail() == resource.data.get('driver_email', '').lower() ||
            isAdmin())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'current_status', 'current_trip_id', 'current_trip_phase', 
             'current_mileage', 'active_ticket_id', 'last_updated', 'on_break',
             'profile_image_url', 'incident_active', 'isFirstLogin', 'updated_at',
             'is_currently_timed_in', 'last_time_in', 'last_time_out',
             'location', 'current_location_name', 'current_city', 'status', 'lastSeen', 'command'
           ]);
      allow write: if isSignedIn() && isAdmin();
    }

    // ── schedules: assigned driver update phase/status; admins full write ────
    match /schedules/{docId} {
      allow read: if isSignedIn() && (
        resource.data.get('driver_uid', '') == request.auth.uid ||
        getAuthEmail() == resource.data.get('driver_email', '').lower() || 
        isAdmin()
      );
      allow write: if isSignedIn() && isAdmin();
      allow update: if isSignedIn()
        && (resource.data.get('driver_uid', '') == request.auth.uid || 
            getAuthEmail() == resource.data.get('driver_email', '').lower() || 
            isAdmin())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'status', 'trip_phase', 'accepted_at', 'started_at', 'picked_up_at', 
             'dropped_off_at', 'completed_at', 'driver_viewed_at', 'total_km_travelled', 
             'current_segment_index', 'total_segments_completed', 'segments', 
             'odometer_start', 'odometer_end', 'refusal_reason', 
             'vehicle_type', 'plate_number', 'actual_route_polyline', 
             'time_of_departure', 'time_of_arrival', 'last_updated',
             'cancellation_reason', 'cancelled_at', 'route_polyline', 'updated_at',
             'driver_uid', 'driver_email', 'actualRoutePoints'
           ]);
    }

    // ── accidents/incidents/issues: createable by owner/email ──────
    match /accidents/{docId} {
      allow read: if isSignedIn() && (
        resource.data.get('driver_uid', '') == request.auth.uid || 
        resource.data.get('driver_email', '').lower() == getAuthEmail() ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.get('driver_uid', '') == request.auth.uid ||
        request.resource.data.get('driver_email', '').lower() == getAuthEmail()
      );
      allow update, delete: if isSignedIn() && isAdmin();
    }

    match /incidents/{docId} {
      allow read: if isSignedIn() && (resource.data.get('driver_uid', '') == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.get('driver_uid', '') == request.auth.uid || request.resource.data.get('driver_email', '').lower() == getAuthEmail());
      allow update, delete: if isSignedIn() && isAdmin();
    }

    match /vehicle_issues/{docId} {
      allow read: if isSignedIn() && (resource.data.get('driver_uid', '') == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.get('driver_uid', '') == request.auth.uid || request.resource.data.get('driver_email', '').lower() == getAuthEmail());
      allow update, delete: if isSignedIn() && isAdmin();
    }

    // ── trip_tickets: drivers create/read own; admins full access ──────
    match /trip_tickets/{docId} {
      allow read: if isSignedIn() && (
        resource.data.get('driver_uid', '') == request.auth.uid || 
        resource.data.get('driver_email', '').lower() == getAuthEmail() ||
        isAdmin()
      );
      allow create, update: if isSignedIn()
        && (request.resource.data.get('driver_email', '').lower() == getAuthEmail()
            || request.resource.data.get('driver_uid', '') == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && isAdmin();
    }

    // ── dtr_logs: owners read/write; admins full access ──────
    match /dtr_logs/{docId} {
      allow read: if isSignedIn() && (resource.data.get('driver_email', '').lower() == getAuthEmail() || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.get('driver_email', '').lower() == getAuthEmail() || isAdmin());
      allow update, delete: if isSignedIn() && isAdmin();
    }

    // ── users: owners profile read/update; admins full CRUD ───────
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'profile_image_url', 'full_name', 'phone', 'updated_at', 'isFirstLogin', 'status', 'role'
           ]);
      allow write: if isSignedIn() && isAdmin();
    }

    // ── notifications: targeted users read; admins full CRUD ───────
    match /notifications/{docId} {
      allow read: if isSignedIn() && (
        resource.data.get('user_id', '') == request.auth.uid || 
        resource.data.get('driver_uid', '') == request.auth.uid ||
        resource.data.get('user_email', '').lower() == getAuthEmail() ||
        resource.data.get('driver_email', '').lower() == getAuthEmail() ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.get('driver_uid', '') == request.auth.uid ||
        request.resource.data.get('driver_email', '').lower() == getAuthEmail() ||
        isAdmin()
      );
      allow update, delete: if isSignedIn() && isAdmin();
    }

    // ── bookings: admins only ─────────
    match /bookings/{docId} {
      allow read, write: if isSignedIn() && isAdmin();
    }

    // ── activity logs: admins only ─────────
    match /activity/{docId} {
      allow read, write: if isSignedIn() && isAdmin();
    }
    match /driver_activity/{docId} {
      allow read: if isSignedIn() && (resource.data.get('driver_uid', '') == request.auth.uid || resource.data.get('driver_email', '').lower() == getAuthEmail() || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.get('driver_uid', '') == request.auth.uid || request.resource.data.get('driver_email', '').lower() == getAuthEmail() || isAdmin());
      allow update, delete: if isSignedIn() && isAdmin();
    }

    // ── Everything else: Default Deny ───────────────────────────────
    match /{document=**} {
      allow read, write: if isSignedIn() && isAdmin();
    }
  }
}
