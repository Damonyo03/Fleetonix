rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Reusable Logic ───────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) && (
        get(path).data.get('role', 'none') in ['super_admin', 'company_admin', 'admin'] || 
        get(path).data.get('user_type', 'none') in ['super_admin', 'company_admin', 'admin']
      );
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // ── driver_locations: owner-only write, admins-only read ──────────────
    match /driver_locations/{docId} {
      allow read: if isSignedIn() && (isOwner(docId) || isAdmin());
      allow write: if isSignedIn() && isOwner(docId)
        // Coordinate plausibility guard
        && request.resource.data.current_latitude is number
        && request.resource.data.current_latitude >= -90
        && request.resource.data.current_latitude <= 90
        && request.resource.data.current_longitude is number
        && request.resource.data.current_longitude >= -180
        && request.resource.data.current_longitude <= 180;
    }

    // ── drivers: admins full access; self-read/update ────────────
    match /drivers/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow update: if isSignedIn() && isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'current_status', 'current_trip_id', 'current_trip_phase', 
             'current_mileage', 'active_ticket_id', 'last_updated', 'on_break',
             'profile_image_url'
           ]);
      allow write: if isSignedIn() && isAdmin();
    }

    // ── bookings: admins full access (Drivers never read these) ─────────
    match /bookings/{docId} {
      allow read, write: if isSignedIn() && isAdmin();
    }

    // ── schedules: assigned driver read/update; admins full write ────
    match /schedules/{docId} {
      // Drivers can read if they are the assigned driver
      allow read: if isSignedIn() && (
        request.auth.token.email.lower() == resource.data.driver_email.lower() || 
        isAdmin()
      );
      allow write: if isSignedIn() && isAdmin();
      allow update: if isSignedIn()
        && request.auth.token.email.lower() == resource.data.driver_email.lower()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'status', 'trip_phase', 'accepted_at', 'started_at', 'picked_up_at', 
             'dropped_off_at', 'completed_at', 'driver_viewed_at', 'total_km_travelled', 
             'current_segment_index', 'total_segments_completed', 'segments', 
             'odometer_start', 'odometer_end', 'refusal_reason', 
             'vehicle_type', 'plate_number', 
             'route_polyline', 'actual_route_polyline', 'time_of_departure', 'time_of_arrival', 'last_updated',
             'cancellation_reason', 'cancelled_at'
           ]);
    }

    // ── trip_tickets: drivers create/read own; admins full access ──────
    match /trip_tickets/{docId} {
      allow read: if isSignedIn() && (
        resource.data.driver_uid == request.auth.uid || 
        resource.data.driver_email.lower() == request.auth.token.email.lower() ||
        isAdmin()
      );
      allow create, update: if isSignedIn()
        && (request.resource.data.driver_email.lower() == request.auth.token.email.lower()
            || request.resource.data.driver_uid == request.auth.uid);
      allow delete: if isSignedIn() && isAdmin();
    }

    // ── incidents/accidents/vehicle_issues: drivers create own; admin full access ─
    match /incidents/{docId} {
      allow read: if isSignedIn() && (resource.data.driver_uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.driver_email.lower() == request.auth.token.email.lower();
      allow update, delete: if isSignedIn() && isAdmin();
    }
    match /accidents/{docId} {
      allow read: if isSignedIn() && (resource.data.driver_uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.driver_email.lower() == request.auth.token.email.lower();
      allow update, delete: if isSignedIn() && isAdmin();
    }
    match /vehicle_issues/{docId} {
      allow read: if isSignedIn() && (resource.data.driver_uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.driver_email.lower() == request.auth.token.email.lower();
      allow update, delete: if isSignedIn() && isAdmin();
    }

    // ── dtr_logs: drivers write/read own records; admins full access ──────
    match /dtr_logs/{docId} {
      allow read: if isSignedIn() && (resource.data.driver_email.lower() == request.auth.token.email.lower() || isAdmin());
      allow create: if isSignedIn() && request.resource.data.driver_email.lower() == request.auth.token.email.lower();
      allow update, delete: if isSignedIn() && isAdmin();
    }

    // ── users: users read/update own profile; admins full CRUD ───────
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow update: if isSignedIn() && isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'profile_image_url', 'full_name', 'phone', 'updated_at'
           ]);
      allow write: if isSignedIn() && isAdmin();
    }

    // ── SECURITY: OTP Collections - CLOUD FUNCTIONS ONLY ────────────────
    match /otps/{docId} {
      allow read, write: if false; 
    }
    match /registration_otps/{docId} {
      allow read, write: if false;
    }

    // ── Everything else: Default Deny ───────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
