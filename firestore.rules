rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── driver_locations: owner-only write, auth-only read ──────────────
    match /driver_locations/{driverEmail} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.email.lower() == driverEmail.lower()
        // Coordinate plausibility guard
        && request.resource.data.current_latitude is number
        && request.resource.data.current_latitude >= -90
        && request.resource.data.current_latitude <= 90
        && request.resource.data.current_longitude is number
        && request.resource.data.current_longitude >= -180
        && request.resource.data.current_longitude <= 180;
    }

    // ── drivers: self-ownership write ───────────────────────────────────
    match /drivers/{userId} {
      allow read: if request.auth != null;
      // Driver can only update their own document
      allow write: if request.auth != null
        && request.auth.uid == userId;
    }

    // ── schedules: drivers update trip_phase only; admins full write ────
    match /schedules/{docId} {
      allow read: if request.auth != null;
      allow update: if request.auth != null
        && request.auth.token.email.lower() == resource.data.driver_email.lower()
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['trip_phase', 'last_updated']);
      allow create, delete: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.role in ['super_admin', 'company_admin', 'admin'];
    }

    // ── incidents: drivers can create; admins can update/delete ─────────
    match /incidents/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.driver_email.lower() == request.auth.token.email.lower();
      allow update, delete: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.role in ['super_admin', 'company_admin', 'admin'];
    }

    // ── accidents: drivers can create; admins full access ───────────────
    match /accidents/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.driver_email.lower() == request.auth.token.email.lower();
      allow update, delete: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.role in ['super_admin', 'company_admin', 'admin'];
    }

    // ── vehicle_issues: drivers can create; admins full access ──────────
    match /vehicle_issues/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.driver_email.lower() == request.auth.token.email.lower();
      allow update, delete: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.role in ['super_admin', 'company_admin', 'admin'];
    }

    // ── trip_tickets: drivers create/update; admins full access ─────────
    match /trip_tickets/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.driver_email.lower() == request.auth.token.email.lower();
      allow update: if request.auth != null
        && (request.auth.token.email.lower() == resource.data.driver_email.lower() ||
            get(/databases/$(database)/documents/users/$(request.auth.uid))
              .data.role in ['super_admin', 'company_admin', 'admin']);
      allow delete: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.role in ['super_admin', 'company_admin', 'admin'];
    }

    // ── dtr_logs: drivers write own records only ─────────────────────────
    match /dtr_logs/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.driver_email.lower()
             == request.auth.token.email.lower();
      allow update, delete: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.role in ['super_admin', 'company_admin', 'admin'];
    }

    // ── Everything else: admin-only write ───────────────────────────────
    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.role in ['super_admin', 'company_admin', 'admin'];
    }
  }
}
