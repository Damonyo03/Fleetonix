rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Secure driver_locations: Read for all users, write only for owner
    match /driver_locations/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Attendance Rules: Drivers can read/write their own records
    match /attendance/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null; // Drivers need to clock in
    }

    // Driver Profiles: Drivers can update their own profile and status
    match /drivers/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null; // Drivers need to toggle status
    }

    // Public Read for Accredited Companies (Required for registration dropdown)
    match /accredited_companies/{companyId} {
      allow read: if true;
      allow write: if request.auth != null && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin');
    }

    // Default catch-all for other collections (temporary permissive)
    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin');
    }
  }
}
