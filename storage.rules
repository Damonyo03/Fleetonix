rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper to check if user is an admin
    function isAdmin() {
      return request.auth != null && (
        ('role' in request.auth.token && request.auth.token.role == 'admin') ||
        ('role' in request.auth.token && request.auth.token.role == 'super_admin') ||
        ('role' in request.auth.token && request.auth.token.role == 'company_admin') ||
        ('user_type' in request.auth.token && request.auth.token.user_type == 'admin')
      );
    }

    // Helper to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // profile_photos: OWNER ONLY read/write (Hardened MSL-01)
    match /profile_photos/{userId} {
      allow read, write: if request.auth.uid == userId || isAdmin();
    }

    // Default: Deny all other access unless Admin
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
